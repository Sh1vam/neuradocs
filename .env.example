# Required. "python scripts/setup_env.py" fills in whatever is missing here, without touching what you set.
GROQ_API_KEY=paste-your-new-key-here
LLM_BIG=openai/gpt-oss-120b
# The login password of the web page (the browser asks for a username: anything). Needed whenever HOST is not 127.0.0.1,
# which is always the case in Docker: the app listens on all addresses inside its container, and the sandbox can reach it there.
APP_PASSWORD=choose-a-long-password
# A secret shared by the app and the sandbox service. You invent it; nobody issues it. Any long random string.
SANDBOX_TOKEN=choose-a-long-random-token

# Ports. APP_PORT is the port on YOUR machine (docker compose). Inside the container the app listens on 8001.
APP_PORT=8001
# 0.0.0.0 would expose the app to your whole network. Keep 127.0.0.1 unless you use a reverse proxy elsewhere.
# APP_BIND=127.0.0.1
# Without Docker (python run.py): HOST and PORT. The Docker image sets HOST=0.0.0.0 and PORT=8001 itself.
# HOST=127.0.0.1
# PORT=8001
# Where chats are stored (default: ~/.neuradocs/neurachat.db; the Docker image uses /data/neurachat.db).
# NEURACHAT_DB=

# Models
# Hugging Face: any chat model of Inference Providers shows up in the model list under "Hugging Face" once HF_TOKEN is set
# (a fine-grained token with "Make calls to Inference Providers"). HF_MODELS=a,b limits the list to the models you name.
# HF_TOKEN=
HF_MODELS=MiniMaxAI/MiniMax-H3-Image,black-forest-labs/FLUX.1-dev,black-forest-labs/FLUX.1-schnell,stabilityai/stable-diffusion-3.5-large,stabilityai/stable-diffusion-3.5-large-turbo,stabilityai/stable-diffusion-xl-base-1.0,Qwen/Qwen-Image-Edit,black-forest-labs/FLUX.1-Kontext-dev,black-forest-labs/FLUX.1-Fill-dev,black-forest-labs/flux-3-image-klein-comfy,timbrooks/instruct-pix2pix,NTQAI/Nxcode-CQ-7B-orpo,Qwen/Qwen2.5-Coder-32B-Instruct,sequelbox/Llama2-70B-SunsetBoulevard,google/flan-t5-large,Qwen/Qwen2.5-3B,Qwen/Qwen2.5-7B,ehristoforu/Falcon3-MoE-2x7B-Insruct,braindao/Qwen2.5-14B,IntervitensInc/internlm2_5-20b-llamafied,Qwen/Qwen2.5-32B,Qwen/Qwen2.5-72B,Qwen/Qwen1.5-110B,FlofloB/100k_fineweb_continued_pretraining_Qwen2.5-0.5B-Instruct_Unsloth_merged_16bit,fblgit/pancho-v1-qw25-3B-UNAMGS,FlofloB/test_continued_pretraining_Phi-3-mini-4k-instruct_Unsloth_merged_16bit,INSAIT-Institute/BgGPT-Gemma-2-27B-IT-v1.0,ehristoforu/coolqwen-3b-it,ehristoforu/fq2.5-7b-it-normalize_false,arcee-ai/Virtuoso-Lite,JungZoona/T3Q-qwen2.5-14b-v1.0-e3,arcee-ai/Arcee-Blitz,Saxo/Linkbricks-Horizon-AI-Avengers-V1-32B,MaziyarPanahi/calme-3.2-instruct-78b,dnhkng/RYS-Llama3.1-Large,Qwen/Qwen2-VL-7B-Instruct,rhymes-ai/Aria,Qwen/Qwen2-VL-72B-Instruct,Qwen/Qwen2.5-0.5B-Instruct,Qwen/Qwen2.5-3B-Instruct,unsloth/phi-4-unsloth-bnb-4bit,tiiuae/Falcon3-10B-Instruct,Cran-May/tempmotacilla-cinerea-0308,upstage/solar-pro-preview-instruct,ehristoforu/0109-test-32b-it,MaziyarPanahi/calme-3.1-instruct-78b,mistralai/Mistral-Large-Instruct-2411,FINGU-AI/Chocolatine-Fusion-14B,tensopolis/virtuoso-lite-tensopolis-v1,wanlige/li-14b-v0.4,FINGU-AI/RomboUltima-32B,CombinHorizon/zetasepic-abliteratedV2-Qwen2.5-32B-Inst-BaseMerge-TIES,rombodawg/Rombos-LLM-V2.5-Qwen-72b,meta-llama/Llama-4-Scout-17B-16E-Instruct
# HF_MODELS_MAX=60
HF_BASE_URL=https://router.huggingface.co/v1
# LLM_SMALL defaults to LLM_BIG, so one model is enough.
LLM_VISION=meta-llama/Llama-4-Scout-17B-16E-Instruct
# HF_MODELS_MAX=60
# HF_BASE_URL=https://router.huggingface.co/v1
# LLM_SMALL defaults to LLM_BIG, so one model is enough.
# LLM_VISION=meta-llama/llama-4-scout-17b-16e-instruct
# gpt-oss reasoning effort for chat: low, medium or high.
# LLM_EFFORT=low

# Internet for the sandbox (off by default; read the README section first). python scripts/setup_env.py --internet adds the first two.
# SANDBOX_PROXY=http://egress:3128
# SANDBOX_INSTALL=1
# EGRESS_ALLOW=pypi.org,files.pythonhosted.org,github.com,router.huggingface.co,huggingface.co,auth.docker.io,registry-1.docker.io,://docker.com

# Local Docker mode only (no compose): "bridge" = FULL internet and LAN access (not recommended).
# SANDBOX_NETWORK=none
# Set by docker-compose for you: the address of the sandbox service.
# SANDBOX_URL=http://sandbox:9000

# Builder, skills, scaling and testing
# DOMAIN=chat.example.com
# BUILD_TEAM=0
# Optional. Lets the Researcher (Build mode, search_projects tool) and the GitHub connector call GitHub as you. Without it GitHub
# allows 10 searches a minute; with it 30. Create a fine-grained token with read-only access to public repositories: it needs no
# other permission, and never give it write access.
# GITHUB_TOKEN=
# Download the local models (document search) automatically before the start. 0 = never download.
# AUTO_DOWNLOAD_MODELS=1
# SKILLS=0
# SKILL_CHARS=3000
# SKILLS_DIR=
# Where connectors are saved (default: next to the chat database).
# CONNECTORS_FILE=
# WEB_CONCURRENCY=1
# SANDBOX_SLOTS=2
# FAKE_LLM=1
# FAKE_LLM_DELAY=1.0
# DocuTeam's own offline tests use this fake model.
# USE_FAKE_LLM=1
