GROQ_API_KEY=paste-your-new-key-here
LLM_BIG=openai/gpt-oss-120b
# LLM_SMALL defaults to LLM_BIG, so one model is enough
# LLM_VISION=meta-llama/llama-4-scout-17b-16e-instruct   (image analysis only: gpt-oss cannot read images)
# LLM_EFFORT=low   (gpt-oss reasoning effort for chat: low, medium or high)

# Online deployment (python bootstrap.py creates these for you)
APP_PASSWORD=choose-a-long-password
SANDBOX_TOKEN=choose-a-long-random-token
# DOMAIN=chat.example.com        (for HTTPS: docker compose --profile tls up -d)
# BUILD_TEAM=0                   (turn off Researcher + Planner to save tokens)
# GITHUB_TOKEN=                  (optional: raises GitHub's search limit for the Researcher)
# FAKE_LLM=1                   (load tests only: a stand-in model, spends no tokens; FAKE_LLM_DELAY=1.0)
# WEB_CONCURRENCY=1             (app processes; each loads the models)
# SANDBOX_SLOTS=2               (parallel sandbox jobs)
