# Required. "python scripts/setup_env.py" fills in whatever is missing here, without touching what you set.
GROQ_API_KEY=paste-your-new-key-here
LLM_BIG=openai/gpt-oss-120b
# The login password of the web page (the browser asks for a username: anything). Needed whenever HOST is not 127.0.0.1,
# which is always the case in Docker: the app listens on all addresses inside its container, and the sandbox can reach it there.
APP_PASSWORD=choose-a-long-password
# A secret shared by the app and the sandbox service. You invent it; nobody issues it. Any long random string.
SANDBOX_TOKEN=choose-a-long-random-token

# Ports. APP_PORT is the port on YOUR machine (docker compose). Inside the container the app listens on 8001.
APP_PORT=8001
# 0.0.0.0 would expose the app to your whole network. Keep 127.0.0.1 unless you use a reverse proxy elsewhere.
# APP_BIND=127.0.0.1
# Without Docker (python run.py): HOST and PORT. The Docker image sets HOST=0.0.0.0 and PORT=8001 itself.
# HOST=127.0.0.1
# PORT=8001
# Where chats are stored (default: ~/.neuradocs/neurachat.db; the Docker image uses /data/neurachat.db).
# NEURACHAT_DB=

# Models
# LLM_SMALL defaults to LLM_BIG, so one model is enough.
# LLM_VISION=meta-llama/llama-4-scout-17b-16e-instruct
# gpt-oss reasoning effort for chat: low, medium or high.
# LLM_EFFORT=low
# HF_TOKEN= Hugging Face token for private models (optional; see README). You can get one at https://huggingface.co/settings/tokens.
# Internet for the sandbox (off by default; read the README section first). python scripts/setup_env.py --internet adds the first two.
# SANDBOX_PROXY=http://egress:3128
# SANDBOX_INSTALL=1
# EGRESS_ALLOW=pypi.org,files.pythonhosted.org,github.com
# Local Docker mode only (no compose): "bridge" = FULL internet and LAN access (not recommended).
# SANDBOX_NETWORK=none
# Set by docker-compose for you: the address of the sandbox service.
# SANDBOX_URL=http://sandbox:9000

# Builder, skills, scaling and testing
# DOMAIN=chat.example.com
# BUILD_TEAM=0
# GITHUB_TOKEN=
# SKILLS=0
# SKILL_CHARS=3000
# SKILLS_DIR=
# WEB_CONCURRENCY=1
# SANDBOX_SLOTS=2
# FAKE_LLM=1
# FAKE_LLM_DELAY=1.0
# DocuTeam's own offline tests use this fake model.
# USE_FAKE_LLM=1
